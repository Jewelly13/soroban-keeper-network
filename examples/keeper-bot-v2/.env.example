# Keeper Bot v2 Configuration Example
# Copy this to .env and fill in your values

# Network to connect to: testnet | public | futurenet
NETWORK=testnet

# Your keeper's secret key (starts with S...)
KEEPER_SECRET_KEY=S...

# Registry contract ID (starts with C...)
REGISTRY_CONTRACT_ID=C...

# Polling interval in milliseconds (minimum 1000)
POLL_INTERVAL_MS=10000

# Maximum tasks to process per round (minimum 1)
MAX_TASKS_PER_ROUND=5

# Maximum concurrent tasks being claimed/executed simultaneously (minimum 1)
MAX_CONCURRENT_TASKS=2

# Minimum profit margin in stroops required to claim a task
MIN_PROFIT_MARGIN_STROOPS=0

# Whether to expire stale tasks (refund owner if past deadline)
EXPIRE_STALE_TASKS=true

# Withdraw accumulated rewards when balance reaches this threshold (stroops)
WITHDRAW_THRESHOLD=10000000

# Maximum retry attempts for transient failures
MAX_RETRIES=3

# Base retry delay in milliseconds
RETRY_BASE_MS=500

# Development: simulate task execution without real executors
SIMULATE_EXECUTION=false

# Database file location (SQLite)
DB_PATH=./keeper-state.db

# Development: single run mode (exit after one round)
RUN_ONCE=false
