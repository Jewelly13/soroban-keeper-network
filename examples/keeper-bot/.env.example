# Network and contract
NETWORK=testnet
REGISTRY_CONTRACT_ID=
KEEPER_SECRET_KEY=

# Polling and transaction behaviour
POLL_INTERVAL_MS=10000
MAX_TASKS_PER_ROUND=5
MAX_RETRIES=3
RETRY_BASE_MS=500
# Required — a funded secret key for the keeper bot
KEEPER_SECRET_KEY=S...

# Required — the address of the keeper registry contract
REGISTRY_CONTRACT_ID=C...

# Optional — network to run on (testnet, futurenet, mainnet)
# Defaults to testnet
NETWORK=testnet

# Optional. A signing key for tasks whose attached verifier is (or is
# compatible with) the reference signature-verifier contract — see
# docs/VERIFIERS.md. This is separate from KEEPER_SECRET_KEY: the party a
# verifier trusts to attest completion is not necessarily the same party
# running this bot. Leave unset if you don't run any verifier-gated tasks,
# or if you're not the party that signs their proofs.
# SIGNATURE_PROOF_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# How often to poll for new tasks (milliseconds, integer, >= 1000)
# Optional - run the keeper loop once and exit (for cron or serverless)
# Defaults to false (daemon mode)
# RUN_ONCE=true

# Optional — how often to poll for new tasks, in milliseconds
# Defaults to 10000 (10 seconds)
POLL_INTERVAL_MS=10000

# Optional — accumulated reward balance at which to trigger a withdrawal
# Defaults to 10 XLM (10000000 stroops)
WITHDRAW_THRESHOLD=10000000

# Optional — max tasks to claim and execute in a single round
# Defaults to 5
MAX_TASKS_PER_ROUND=5

# Optional — max retries for transient RPC errors
# Defaults to 3
MAX_RETRIES=3

# Optional — base delay for retry back-off, in milliseconds
# Defaults to 500
RETRY_BASE_MS=500

# Optional — whether to expire stale tasks (true/false)
# Defaults to true
EXPIRE_STALE_TASKS=true
WITHDRAW_THRESHOLD=10000000

# Profitability guardrails (all amounts are stroops)
# Minimum net reward after the registry fee before pursuing a task.
MIN_NET_REWARD_STROOPS=1000000
# Net reward must exceed this multiple of the estimated total cost.
MIN_PROFIT_MULTIPLE=2.0
# Static per-transaction estimate. Include claim and execute; withdrawal is
# amortised automatically as a third transaction in the profitability check.
ESTIMATED_TX_COST_STROOPS=10000

# Run one polling round and exit instead of running as a daemon.
# RUN_ONCE=true
# Optional — page size for getEvents queries
# Defaults to 100
EVENTS_PAGE_SIZE=100

# Optional — max pages to fetch in a single round
# Defaults to 10
EVENTS_MAX_PAGES=10
