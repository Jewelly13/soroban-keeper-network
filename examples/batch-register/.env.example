# ──────────────────────────────────────────────────────────────
# Soroban Batch Registration Helper — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ──────────────────────────────────────────────────────────────

# Network: testnet | futurenet | mainnet
NETWORK=testnet

# The task owner's Stellar secret key (starts with S...). This account funds
# every task in the list, so it needs a balance of the registry's reward token
# covering the full sum plus transaction fees.
# Fund on testnet: https://laboratory.stellar.org/#account-creator
#
# Optional for `--dry-run`: without it the script validates the file locally
# and skips the on-chain reads (simulation needs a funded source account).
OWNER_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# The deployed KeeperRegistry contract ID (starts with C...)
REGISTRY_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Headroom added to each chunk's `max_total_reward`, in basis points.
#
# Leave at 0. `max_total_reward` is a ceiling on the escrow one call may pull
# from you, and the call is atomic — either every entry registers or none does
# — so padding rescues no partial-failure case. It only widens the window in
# which the transaction could move more escrow than you reviewed, which is
# exactly what the parameter exists to prevent. Set this only if your workflow
# genuinely mutates the task list between review and submission; the script
# prints a warning whenever it is non-zero.
MAX_TOTAL_REWARD_BUFFER_BPS=0
